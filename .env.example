# Copy to .env and fill in. Expo (SDK 49+) automatically loads this file and
# inlines any EXPO_PUBLIC_* variable into the bundle at build time — no
# extra config needed, but you DO need to restart the Expo dev server
# (not just reload the app) whenever you change this file.

# The backend's base URL, including /api/v1. Three common cases:
#
#   Web / iOS simulator on the same machine as the backend:
#     EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
#
#   Physical device on the same Wi-Fi as your dev machine:
#     EXPO_PUBLIC_API_BASE_URL=http://<your-machine's-LAN-IP>:4000/api/v1
#
#   Physical device anywhere (via ngrok — see homeservice-backend/docs/NGROK.md):
#     EXPO_PUBLIC_API_BASE_URL=https://<your-subdomain>.ngrok-free.app/api/v1
#
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
